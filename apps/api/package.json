{
  "name": "@farmledger/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "prisma db push && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:push": "prisma db push --skip-generate",
    "db:reset": "tsx --env-file-if-exists=.env src/tools/reset-database.ts",
    "db:studio": "prisma studio",
    "user:reset-password": "tsx --env-file-if-exists=.env src/tools/reset-password.ts",
    "db:restore": "tsx --env-file-if-exists=.env src/tools/restore-backup.ts",
    "backup:new-key": "tsx --env-file-if-exists=.env src/tools/backup-key.ts",
    "backup:decrypt": "tsx --env-file-if-exists=.env src/tools/decrypt-backup.ts",
    "security:check": "tsx --env-file-if-exists=.env src/tools/security-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "^5.6.1",
    "qrcode": "1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
