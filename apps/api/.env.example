# Copy to .env and adjust. Never commit the real .env.
# SQLite for a single-machine install. For a hosted multi-user install use PostgreSQL
# (change provider in prisma/schema.prisma to "postgresql" and set the URL below).
DATABASE_URL="file:./farmledger.db"
PORT=4000
# Which network FarmLedger answers on. 0.0.0.0 = every network (office LAN and Wi-Fi too). Behind `tailscale serve`
# use 127.0.0.1, so nobody can skip HTTPS by opening port 4000 directly. See docs/SECURITY-SETTINGS.md.
HOST=0.0.0.0
NODE_ENV=development
# Initial owner account created by the seed. The owner is asked to change it at first login.
# Delete the ADMIN_PASSWORD line once FarmLedger is set up (security-check.bat warns while it is here).
ADMIN_EMAIL=owner@farm.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Farm Owner
# Set to "true" to import October 2026 workbook history during seeding.
SEED_HISTORY=true
# Only set this when FarmLedger sits behind an HTTPS proxy: the proxy's address (comma-separated list allowed).
# 127.0.0.1 for `tailscale serve` or Caddy on the same computer. Leave unset otherwise, so nobody can fake their
# address to get past the sign-in limit. The session cookie is marked Secure whenever the browser used HTTPS.
# TRUST_PROXY=127.0.0.1
# Passkeys (fingerprint / face sign-in) are tied to one https address. Behind `tailscale serve`, set the final
# address here (after any rename), e.g. https://farm-name.your-tailnet.ts.net. See docs/PASSKEYS.md.
# PASSKEY_ORIGIN=
# Staff may add or void records dated at most this many days back; the owner and accountant are not limited.
# BACKDATE_DAYS=7
# Session lifetime in hours.
SESSION_HOURS=12
# Automatic daily backups (SQLite only): while FarmLedger runs it saves one copy of the database per day.
# Folder for the backup files (default: a "backups" folder next to the database, i.e. apps/api/prisma/backups).
# BACKUP_DIR=
# Optional second folder that also receives every backup, e.g. a USB drive (E:\FarmLedger) or a Google Drive folder.
# BACKUP_COPY_DIR=
# Days of backups to keep (the newest 7 are always kept).
# BACKUP_KEEP_DAYS=30
